 "notes": {
  "inca": "1530년 데이터가 그대로 남은 잉카 영역 → 스페인령 페루 부왕령",
  "quebec": "1763년 파리 조약 이후 영국령",
  "colony19": "영국 식민지 — 원본은 독립국처럼 따로 표기",
  "rupert": "허드슨만 회사령(영국)",
  "malta": "1800년 이후 영국령(1964 독립)",
  "ceylon": "1796년 점령, 1802년 영국 직할 식민지",
  "ph_es": "1565~71년 이후 스페인 식민지(내륙·남부 이슬람 지역은 통제 밖)",
  "habsburg_nl": "합스부르크령 네덜란드 — 카를 5세·펠리페 2세가 직접 다스린 스페인 계통 영지(원본은 오스트리아로 분류)",
  "aragon_italy": "아라곤 왕관에 속한 이탈리아 왕국 — 스페인 왕이 겸함(1700년 원본은 오스트리아·사보이아로 잘못 표기)",
  "milan_es": "1535년부터 스페인령 밀라노 공국(1714년 오스트리아로)",
  "spanish_nl": "스페인령 네덜란드(남부) — 1714년 오스트리아로 넘어감(원본 표기는 ‘Luxembourg’)",
  "luisiana_1783": "스페인령 루이지애나(1762–1800) — 원본은 프랑스로 잘못 표기",
  "formosa": "네덜란드는 1662년 대만에서 축출, 1683년 청이 편입 — 원본의 \"Dutch Formosa\"는 시대 착오",
  "egypt_ot": "오스만 제국의 속주(1517~). 1805년 이후 무함마드 알리 왕조의 사실상 자치",
  "guiana_1783": "에세키보·데메라라는 1783년 당시 네덜란드 식민지(영국령이 된 것은 1796년 점령, 1814년 조약) — 원본은 영국령으로 표기",
  "ur_3000": "우르가 패권을 쥔 것은 기원전 21세기(우르 제3왕조)입니다. 이 시점은 수메르 도시국가들이 병립하던 때로 고쳤습니다.",
  "hurrian_3000": "후르리인이 기록에 나타나는 것은 기원전 2300년 무렵부터라 이 시점에서는 뺐습니다.",
  "hatti_2000": "히타이트 왕국은 기원전 1650년 무렵에 섭니다. 이 시점의 아나톨리아 중부는 하티인의 도시국가들로 고쳤습니다.",
  "xia": "하(夏)는 후대 문헌의 전승이며, 고고학적으로 확정된 왕조가 아닙니다(얼리터우 문화와 연결하는 견해가 있음).",
  "shang_1500": "주(周)는 기원전 1046년에 섭니다. 이 시점은 상(商)으로 고쳤습니다. 원자료는 기원전 1500·1000·700년에 같은 그림을 씁니다.",
  "urartu_1500": "우라르투 왕국은 기원전 9세기에 서므로 이 시점에서는 뺐습니다.",
  "nairi_1000": "우라르투 왕국은 기원전 9세기에 섭니다. 이 시점은 그 전신인 나이리 부족 연맹으로 고쳤습니다.",
  "canaan_1500": "다윗·솔로몬 왕국은 기원전 10세기의 일입니다. 이 시점은 이집트 영향 아래 있던 가나안 도시국가들로 고쳤습니다.",
  "judah_700": "통일 왕국은 기원전 930년 무렵 갈라졌고 북이스라엘은 기원전 722년 아시리아에 멸망했습니다. 이 시점에 남은 것은 유다 왕국(아시리아의 속국)입니다.",
  "phrygia_1500": "프리기아인이 아나톨리아에 들어온 것은 기원전 1200년 무렵 이후라 이 시점에서는 뺐습니다.",
  "wu_1500": "오(吳)는 전승으로도 기원전 11세기 이후의 나라라 이 시점에서는 뺐습니다.",
  "saba_1500": "사바 왕국은 기원전 1000년 무렵 이후에 확인되므로 이 시점에서는 뺐습니다.",
  "mycenae_1500": "폴리스가 생기기 전입니다. 이 시점은 미케네 문명의 궁전 국가들로 고쳤습니다.",
  "neohittite_1000": "히타이트 제국은 기원전 1180년 무렵 무너졌습니다. 이 시점은 그 뒤를 이은 신히타이트 소국들로 고쳤습니다.",
  "assyria_700": "신히타이트 소국들은 기원전 8세기 말까지 신아시리아 제국에 병합되었습니다(카르케미시 기원전 717년).",
  "assyria_700b": "아람계 왕국들은 기원전 8세기에 신아시리아 제국에 정복되었습니다(다마스쿠스 기원전 732년). 원자료는 이 시점의 아시리아를 지나치게 작게 그렸습니다.",
  "assyria_700c": "바빌로니아는 기원전 729년부터 아시리아 왕의 지배 아래 있었습니다(기원전 689년 센나케리브가 바빌론 파괴). 독립을 되찾는 것은 기원전 626년입니다.",
  "xiongnu_400": "흉노가 연맹을 이룬 것은 기원전 209년(묵돌 선우)입니다. 이 시점에는 여러 유목 부족이 흩어져 있었고, 원자료의 영역은 후대의 범위를 앞당겨 그린 것입니다.",
  "antigonus_300": "안티고노스는 기원전 301년 입소스 전투에서 죽었고 영토는 분할되었습니다. 소아시아 대부분은 리시마코스가 차지했습니다(시리아는 셀레우코스, 남부는 프톨레마이오스가 차지 — 근사 표기).",
  "numidia_200": "시팍스는 기원전 203년 패해 사로잡혔고, 누미디아는 마시니사 아래 통합되었습니다.",
  "numidia_200b": "갈라는 기원전 206년 죽었고, 아들 마시니사가 누미디아를 통합했습니다.",
  "shunga_100": "마우리아 제국은 기원전 185년 무렵 무너지고 슝가 왕조가 이었습니다.",
  "yuezhi_100": "쿠샨 제국은 기원후 1세기에 섭니다. 이 시점의 박트리아는 대월지가 차지했고, 남쪽에는 인도-그리스·사카 세력이 섞여 있었습니다.",
  "sasan_300": "파르티아는 224년 사산 왕조에 무너졌습니다.",
  "suren_300": "수렌 가문의 인도-파르티아 왕국은 3세기 전반에 사라졌고, 이 일대는 사산 제국과 그 분봉 왕국(쿠샨샤)이 다스렸습니다(근사 표기).",
  "gupta_300": "굽타 왕조가 제국으로 커지는 것은 찬드라굽타 1세가 즉위한 320년 무렵부터입니다. 이 시점의 영역은 후대 범위를 앞당겨 그린 것입니다.",
  "vakataka": "사타바하나 왕조는 3세기 전반에 끝났습니다. 데칸 지방은 바카타카 왕조 등이 이었습니다.",
  "qi_500": "동진은 420년에 끝났습니다. 이 시점의 남조는 남제(479~502)입니다.",
  "tang_700": "수는 618년에 끝나고 당이 이었습니다.",
  "umayyad_700": "사산 제국은 651년 이슬람 세력에 멸망했습니다. 이 시점에는 우마이야 칼리파국의 영토입니다.",
  "hejaz_700": "헤자즈는 이슬람 국가의 발상지로, 이 시점에는 우마이야 칼리파국의 영토입니다.",
  "balhae_700": "고구려는 668년 멸망했고, 698년 발해가 섰습니다(옛 고구려 남부는 신라·당의 영역 — 근사 표기).",
  "turgesh_700": "서돌궐은 657년 당에 무너졌고, 699년 무렵부터 튀르게시가 그 자리를 차지했습니다.",
  "tibet_900": "토번 제국은 842년 무너졌고, 이후 티베트는 여러 세력으로 갈라진 분열기였습니다.",
  "uyghur_900": "위구르 제국은 840년 키르기스에 무너졌습니다. 이 시점의 몽골 고원은 예니세이 키르기스, 톈산 일대는 고창 위구르·감주 위구르의 영역입니다.",
  "magyar_900": "아바르 칸국은 9세기 초에 사라졌고, 895년 무렵 마자르인이 판노니아 평원에 들어왔습니다.",
  "carol_900": "카롤링거 제국은 888년 해체되었습니다. 이 영역은 이탈리아·부르군트 등 후계 왕국들입니다.",
  "norse_1000": "덴마크·노르웨이의 연합은 1380년 이후의 일입니다. 이 시점에는 덴마크 왕의 영향 아래 있던 노르웨이와, 독립된 노르드인 정착지(아이슬란드·그린란드)입니다.",
  "xixia_1000": "서하는 1038년에 섭니다. 이 시점은 그 전신인 탕구트의 정난군 절도사 세력입니다.",
  "khazar_1000": "하자르 칸국은 965~969년 키예프 루스의 공격으로 무너졌습니다. 이 시점에는 잔존 세력만 남았습니다.",
  "daiviet_1000": "베트남은 938년 독립했고 968년 대구월(다이꼬비엣)을 세웠습니다.",
  "dali": "남조는 902년에 무너졌고, 937년부터 대리국이 이었습니다.",
  "mon_1100": "수코타이 왕국은 1238년에 섭니다. 이 시점은 라보·하리푼차이 같은 몬족 계통 나라들과 크메르 제국의 세력권입니다.",
  "tiwanaku_1200": "티와나쿠는 1000~1100년 무렵 무너졌고, 그 뒤 아이마라계 소왕국들이 들어섰습니다.",
  "wari_1200": "와리는 1000년 무렵 무너졌습니다. 이후 안데스에는 여러 지역 세력이 병립했습니다.",
  "mongol_1200": "몽골 제국의 성립은 1206년입니다. 이 시점은 테무진이 몽골 고원의 부족들을 통합해 가던 때입니다.",
  "jin_1200": "요는 1125년 금에 멸망했습니다.",
  "ayyubid_1200": "파티마 칼리파국은 1171년 살라딘이 끝냈고, 아이유브 왕조가 이었습니다.",
  "ghurid_1200": "가즈나 왕조는 1186년 구르 왕조에 멸망했습니다.",
  "ghurid_1200b": "델리 술탄국은 1206년에 섭니다. 이 시점의 북인도는 1192년 이후 구르 왕조가 정복한 땅입니다.",
  "ifat_1200": "이파트 술탄국은 1285년에 섭니다. 이 시점의 에티오피아 고원은 자그웨 왕조, 동쪽은 셰와 술탄국 등의 영역입니다.",
  "melayu": "스리위자야는 11세기 촐라의 원정 뒤 쇠퇴해 13세기에 사라졌습니다. 이 시점의 수마트라는 믈라유(다르마스라야·파가루융) 등의 영역이며, 14세기 후반에는 마자파힛의 영향 아래 들었습니다.",
  "burma_1300": "파간 왕조는 1287년 몽골의 침입으로 무너졌고, 이후 미얀마는 핀야·아바·한타와디 등으로 갈라졌습니다.",
  "beylik_1400": "룸 술탄국은 1308년에 끝났습니다. 이 시점의 아나톨리아 내륙은 카라만 등 튀르크계 군소 군주국(베이릭)들입니다.",
  "japan_1400": "가마쿠라 막부는 1333년에 끝났습니다. 이 시점은 무로마치 막부 시기입니다.",
  "horde_1400": "백장·청장 칸국은 1380년 무렵 토크타미시 아래 다시 통합되어 킵차크 칸국을 이뤘습니다.",
  "delhi_1400": "델리 술탄국은 1398년 티무르의 약탈 뒤 델리 주변으로 줄어들었습니다. 원자료의 영역은 그 전의 범위입니다.",
  "c_maurya_300": "기원전 303년 무렵 셀레우코스 1세는 아라코시아·게드로시아 등 동쪽 속주를 찬드라굽타 마우리아에게 넘겼습니다. 원자료는 셀레우코스령으로 남겨 두었습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_parthia_100": "파르티아는 기원전 141년까지 이란과 메소포타미아를 차지했고, 셀레우코스 왕국은 시리아 일대로 줄었습니다. 원자료는 그 전의 범위를 그렸습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_jin_1200": "송은 1127년 화북을 금에 잃었습니다(남송). 원자료는 1100년 국경을 그대로 썼습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_buyid_1200": "부와이 왕조는 1062년에 끝났습니다. 이 시점의 이란·이라크는 호라즘·구르·아바스 칼리파국 등이 나눠 가졌습니다. 원자료 영역을 Cliopatria의 나라들로 갈아 끼웠습니다.",
  "c_yuan_1400": "원은 1368년 중국 본토를 잃고 몽골 고원으로 물러났습니다(북원). 이 시점의 중국은 명입니다. 원자료 영역을 Cliopatria의 나라들로 갈아 끼웠습니다.",
  "c_chagatai_1500": "원자료는 몽골 고원까지 차가타이 칸국으로 그렸지만, 이 시점의 차가타이 계통(모굴리스탄)은 톈산·타림 일대뿐입니다. 몽골 고원은 북원, 초원 서부는 카자흐 칸국 등입니다. 원자료 영역을 Cliopatria의 나라들로 갈아 끼웠습니다.",
  "c_horde_1500": "백장 칸국은 15세기에 해체되어 시비르 칸국·카자흐 칸국·노가이 칸국 등으로 갈라졌습니다. 원자료 영역을 Cliopatria의 나라들로 갈아 끼웠습니다.",
  "c_iraq_1530": "오스만 제국이 바그다드와 이라크를 차지한 것은 1534년입니다. 이 시점에는 사파비 왕조의 영토입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "jin_name": "원자료 표기 ‘Jin’은 진(晉)입니다. 12세기의 금(金)과 구별해 적었습니다.",
  "c_tunis_1530": "오스만 제국이 튀니지를 차지한 것은 1574년입니다(1534년 일시 점령). 이 시점에는 하프스 왕조의 땅입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_hungary_1530": "1526년 모하치 전투 뒤 헝가리는 오스만의 봉신 왕(서포여이 야노시)과 합스부르크가 다투던 때입니다. 오스만의 직접 지배는 1541년 부다 점령부터입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_safavid_1650": "1639년 주하브 조약으로 캅카스 동부와 이란 서부는 사파비 왕조의 땅으로 확정되었습니다. 원자료는 16세기 말 오스만이 잠시 차지했던 범위를 그렸습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_ming_north": "명은 만리장성 이북의 몽골 고원을 다스리지 못했습니다. 이 일대는 북원(몽골)의 땅입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_qing_mongolia": "내몽골은 1636년, 할하(외몽골)는 1691년, 준가르(신장)는 1757~59년 청에 들어갔습니다. 원자료는 ‘중앙아시아 칸국들’로 뭉뚱그렸습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_ru_steppe": "남시베리아 일대는 17세기에 러시아가 차지했습니다. 원자료는 ‘중앙아시아 칸국들’로 뭉뚱그렸습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_amur": "1689년 네르친스크 조약으로 아무르강 유역은 청의 땅이 되었습니다. 러시아가 이 일대를 얻는 것은 1858~60년(아이훈·베이징 조약)입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_mughal": "무굴 제국은 1526년 북인도를 차지했고, 악바르 때 구자라트(1573)·벵골(1576)·카슈미르·신드까지 넓혔습니다. 원자료는 이 지역을 ‘이슬람·힌두 국가들’로 남겨 두었습니다. 경계는 Cliopatria에서 가져왔습니다.",
  "c_rajput_1600": "라지푸트 왕국들은 악바르 때 대부분 무굴 제국의 봉신이 되었습니다(메와르는 1615년). 경계는 Cliopatria에서 가져왔습니다.",
  "c_burma_1880": "영국은 1826년·1852년에 하부 버마를 차지했고, 상부 버마(꼰바웅 왕조)를 병합한 것은 1886년입니다. 경계는 Cliopatria에서 가져왔습니다.",
  "rioplata_1815": "리오데라플라타는 1810년 5월 혁명 뒤 스페인의 지배에서 벗어났고 다시 정복되지 않았습니다(독립 선언 1816년). 원자료는 스페인령으로 표기했습니다."
 },
